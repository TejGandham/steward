{
  "hooks": {
    "SessionStart": [
      {"matcher": "startup|resume|clear|compact|fork",
       "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/steward_hook.py\" session-start", "timeout": 15}]}
    ],
    "PreToolUse": [
      {"matcher": "^(Edit|Write|MultiEdit|NotebookEdit|Bash)$",
       "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/steward_hook.py\" gate", "timeout": 10}]},
      {"matcher": "^(Task|Agent)$",
       "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/steward_hook.py\" delegated", "timeout": 10}]}
    ],
    "PostToolUse": [
      {"matcher": "^(Task|Agent)$",
       "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/steward_hook.py\" delegated", "timeout": 10}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/steward_hook.py\" prose-gate", "timeout": 15}]}
    ]
  }
}
