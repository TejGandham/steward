{
  "hooks": {
    "SessionStart": [{"hooks": [{
      "type": "command",
      "command": "python3 \"${PLUGIN_ROOT}/codex/steward.py\" session-start",
      "timeout": 15
    }]}],
    "PreToolUse": [{"matcher": "^Bash$", "hooks": [{
      "type": "command",
      "command": "python3 \"${PLUGIN_ROOT}/codex/steward.py\" gate",
      "timeout": 10
    }]}],
    "Stop": [{"hooks": [{
      "type": "command",
      "command": "python3 \"${PLUGIN_ROOT}/codex/steward.py\" prose-gate",
      "timeout": 15
    }]}]
  }
}
